# test/inhoud.test.js valt om als iemand die bouw vergeet.
# Wat "versie" doet staat niet in git maar in de instellingen van de kloon; zie
# test/samenvoegen.js (npm run bouw en de studio zetten het vanzelf).
versie.txt merge=versie
